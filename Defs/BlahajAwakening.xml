<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PsychicRitualRoleDef MayRequire="Ludeon.RimWorld.Anomaly,oldmanwhistler.BlahajPlush">
    <defName>OMW_BlahajAwakeningVictim</defName>
    <label>sacrifice</label>
    <allowedCount>1</allowedCount>
    <allowedConditions>Default, Downed, Prisoner, Sleeping</allowedConditions>
    <applyPowerOffset>false</applyPowerOffset>
