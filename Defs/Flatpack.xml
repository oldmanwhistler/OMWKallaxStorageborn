<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <JobDef>
    <defName>OMW_AssembleFlatpack</defName>
    <driverClass>OMWKallaxStorageborn.JobDriver_AssembleFlatpack</driverClass>
    <reportString>assembling flatpack.</reportString>
  </JobDef>

  <ThingDef>
    <defName>OMW_SB_Flatpack</defName>
    <label>Flatpack</label>
    <description>A flat-packed furniture body waiting to be assembled.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <graphicData>
      <texPath>Things/Item/OMW_Ikea_Flatpack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>100</MarketValue>
      <Mass>50</Mass>
    </statBases>
    <stackLimit>1</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="OMWKallaxStorageborn.CompProperties_Flatpack" />
    </comps>
  </ThingDef>
</Defs>
